# Vercel / 本番で必須
# Neon: ダッシュボードの Connection string（推奨: sslmode=require 付き）を貼る
# DATABASE_URL="postgresql://neondb_owner:...@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/db?sslmode=require"
JWT_SECRET="replace-with-64-char-random-string-minimum-32-chars"

# Vercel Cron（ダッシュボードで設定するとリクエストに付与）
CRON_SECRET="replace-with-random-secret"

# 推奨: 本番 URL（メール・リンク用）
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# 任意: 進捗の AI チェック
# 既定は Claude: ANTHROPIC_API_KEY があればそれを使用（OpenAI キーが併設されていても Claude 優先）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OpenAI にだけ切り替える場合（Claude キー未設定、または明示で OpenAI のみ）:
# AI_REVIEW_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# TEAMS_WEBHOOK_URL=
#
# 開発のみ（npm run dev）: POST /api/dev/test-teams で Webhook 試験。next start / 本番ビルドでは 404。
# 設定すると Authorization: Bearer が必須になります。
# DEV_TOOLS_SECRET=
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=
# ADMIN_NOTIFY_EMAIL=
# SEED_ADMIN_PASSWORD= SEED_MEMBER_PASSWORD=
